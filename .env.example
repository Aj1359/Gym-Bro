# ==========================================
# GymBro Environment Configuration Template
# Copy this file to .env before starting
# ==========================================

# ── Database (PostgreSQL / Supabase) ──
# For local Docker postgres: jdbc:postgresql://postgres:5432/gymbro
# For remote Supabase: jdbc:postgresql://aws-1-ap-south-1.pooler.supabase.com:6543/postgres?prepareThreshold=0
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/gymbro
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SUPABASE_DB_PASSWORD=postgres

# ── JWT Security ──
# Must be a 256-bit (minimum 32 characters) secret key
JWT_SECRET=9a2f694578e9f1a23c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b
JWT_ACCESS_TOKEN_EXPIRY_MS=900000      # 15 minutes
JWT_REFRESH_TOKEN_EXPIRY_MS=604800000  # 7 days

# ── Redis Cache ──
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

# ── Apache Kafka ──
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ── Supabase CDN / Asset Storage ──
SUPABASE_STORAGE_BASE_URL=https://fcrpsntztbdimuznjyos.supabase.co/storage/v1/object/public/exercise-images/

# ── Ports ──
BACKEND_PORT=8080
FRONTEND_PORT=80
